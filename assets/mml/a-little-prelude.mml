#title "A Little Prelude by mmlx"

; Park your cursor in this voice, then give it a spin in the mmlx panel's FM Voice tab.
; Warm Bass
@1 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        31, 6,  0,  6,  1, 53, 0,  4,  0,  0,  0,
        31, 7,  1,  6,  1, 47, 0,  1,  0,  0,  0,
        31, 6,  1,  6,  2, 35, 0,  1,  0,  0,  0,
        31, 5,  0,  9,  1,  0, 0,  1,  0,  0,  0,
    /* CON FL OP */
        0,  2, 15
}

; Electric Piano
@2 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        31, 14, 15, 14,  6, 58, 1, 12,  0,  0,  0,
        31, 18,  6,  8,  1,  4, 1,  1,  0,  0,  0,
        31, 15,  5, 11,  1, 40, 1,  1,  4,  0,  0,
        31, 18,  6,  8,  1,  0, 1,  1,  4,  0,  0,
    /* CON FL OP */
        4,  0, 15
}

; Ready to let it fly? Open the Playback tab and press Play!
